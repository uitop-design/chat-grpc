{
  "name": "chat-grpc",
  "version": "0.0.1",
  "description": "Rooms chat built as gRPC microservices on NestJS",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prebuild": "npm run prisma:generate",
    "build": "nest build api-gateway && nest build auth && nest build chat",
    "build:api-gateway": "nest build api-gateway",
    "build:auth": "nest build auth",
    "build:chat": "nest build chat",
    "start:api-gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth --watch",
    "start:chat": "nest start chat --watch",
    "typecheck": "tsc --noEmit -p apps/api-gateway/tsconfig.app.json && tsc --noEmit -p apps/auth/tsconfig.app.json && tsc --noEmit -p apps/chat/tsconfig.app.json",
    "lint": "oxlint --type-aware apps/ libs/",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "proto:generate": "buf generate",
    "prisma:generate": "prisma generate --config apps/auth/prisma.config.ts && prisma generate --config apps/chat/prisma.config.ts",
    "prisma:migrate:auth": "prisma migrate dev --config apps/auth/prisma.config.ts",
    "prisma:migrate:chat": "prisma migrate dev --config apps/chat/prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config apps/auth/prisma.config.ts && prisma migrate deploy --config apps/chat/prisma.config.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@rspack/core": "^2.1.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-proto": "^2.18.3",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
